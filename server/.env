SUBDIRECTORY_PREFIX=/innogpt

; 第2步:在后端代码中使用环境变量
; 在Node.js项目中,安装dotenv包:

; npm install dotenv
; 在项目的入口文件(如app.js或server.js)的顶部,添加以下内容:

; require('dotenv').config();
; 创建一个.env文件,并添加以下内容:

; SUBDIRECTORY_PREFIX=/inno
; 在代码中,使用process.env.SUBDIRECTORY_PREFIX访问环境变量。例如:

; app.use(process.env.SUBDIRECTORY_PREFIX, express.static('build'));
; 对所有后端路由和中间件执行此操作。